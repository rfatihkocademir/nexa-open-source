# Nexa deployment configuration
# Run ./scripts/install.sh to create a private .env with generated secrets.

COMPOSE_PROJECT_NAME=nexa
COMPOSE_PROFILES=cpu

# Public application address
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080
PUBLIC_URL=http://localhost:8080
BACKEND_PUBLIC_URL=http://localhost:8080
ALLOWED_ORIGINS=
TRUST_PROXY=1

# PostgreSQL (secret values are intentionally blank)
DB_USER=nexa
DB_PASSWORD=
DB_NAME=nexa

# Application cryptography
JWT_SECRET=
DATA_ENCRYPTION_KEY=
AUDIT_SIGNING_KEY=
AUDIT_FAIL_CLOSED=true

# Initial organization and owner account
DEFAULT_ORGANIZATION_SLUG=default
BOOTSTRAP_ORGANIZATION_NAME=Nexa
BOOTSTRAP_ADMIN_EMAIL=admin@nexa.local
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=Nexa
BOOTSTRAP_ADMIN_LAST_NAME=Admin
ALLOW_PUBLIC_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=false

# Object storage
MINIO_ROOT_USER=nexa
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=nexa
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Browser automation
BROWSERLESS_TOKEN=
BROWSERLESS_CONNECTION_TIMEOUT=600000
PLAYWRIGHT_EXECUTION_TIMEOUT_MS=600000
MAX_PLAYWRIGHT_CONCURRENCY=2
AUTOMATION_BASE_URL=http://frontend
AUTOMATION_ALLOWED_HOSTS=frontend

# AI provider chain. Ollama is private and enabled by default.
AI_PROVIDER=ollama
AI_ALLOW_EXTERNAL_DATA=false
AI_QUEUE_ATTEMPTS=2
AI_READINESS_REQUIRED=true
AI_READINESS_GENERATION_PROBE=true

# Ollama. Set COMPOSE_PROFILES=gpu only when the NVIDIA Container Toolkit works.
OLLAMA_BIND_ADDRESS=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MODEL_PULL_TIMEOUT_MS=1800000
OLLAMA_STARTUP_TIMEOUT_MS=120000

# Optional external AI providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional outbound integrations
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_API_KEY=
GITHUB_WEBHOOK_SECRET=
WEBHOOK_ALLOWED_DOMAINS=
SIEM_ALLOWED_DOMAINS=
API_OUTBOUND_ALLOWED_HOSTS=
JIRA_ALLOWED_DOMAINS=

# Data lifecycle
ENABLE_RETENTION_PURGE=false
SOFT_DELETE_RETENTION_DAYS=30
