{
  "name": "backend",
  "version": "1.0.0",
  "license": "GPL-2.0-only",
  "engines": {
    "node": ">=20 <23"
  },
  "description": "Nexa API and background workers",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "prisma:generate": "prisma generate",
    "bootstrap": "node dist/scripts/bootstrap.js",
    "seed:prompts": "node dist/scripts/seedPrompts.js",
    "ensure:ollama-models": "node dist/scripts/ensureOllamaModels.js",
    "test": "npm run build && playwright test tests/api",
    "security:encrypt-integrations": "npm run build && node dist/scripts/encryptIntegrationConfigs.js",
    "security:rechain-audit": "npm run build && node dist/scripts/rechainAuditLogs.js",
    "start": "node dist/server.js",
    "pm2:start": "npm run build && npx pm2 start ecosystem.config.js",
    "pm2:start:prod": "npm run build && npx pm2 start ecosystem.config.js --env production",
    "pm2:stop": "npx pm2 stop nexa-api",
    "pm2:restart": "npx pm2 restart nexa-api",
    "pm2:reload": "npx pm2 reload nexa-api",
    "pm2:delete": "npx pm2 delete nexa-api",
    "pm2:logs": "npx pm2 logs nexa-api",
    "pm2:status": "npx pm2 status",
    "pm2:monit": "npx pm2 monit"
  },
  "keywords": [
    "nexa",
    "sdlc",
    "quality-management"
  ],
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/express-rate-limit": "^5.1.3",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.995.0",
    "@aws-sdk/s3-request-presigner": "^3.995.0",
    "@google/genai": "^1.41.0",
    "@playwright/test": "^1.57.0",
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/multer": "^2.0.0",
    "@types/pdfkit": "^0.17.4",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.70.0",
    "cheerio": "^1.1.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "multer-s3": "^3.0.1",
    "openid-client": "^5.7.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.17.2",
    "playwright": "^1.57.0",
    "pm2": "^7.0.3",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0",
    "winston": "^3.18.3",
    "zod": "^4.1.13"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "js-yaml": "^5.2.3"
  }
}
