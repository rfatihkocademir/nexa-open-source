generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            String                    @id @default(uuid())
  email                         String                    @unique
  password                      String
  firstName                     String
  lastName                      String
  role                          Role                      @default(TESTER)
  isActive                      Boolean                   @default(true)
  avatarUrl                     String?
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt
  deletedAt                     DateTime?
  emailVerifiedAt               DateTime?
  tokenVersion                  Int                       @default(0)
  mfaEnabled                    Boolean                   @default(false)
  mfaSecretEncrypted            String?
  approvalEvents                ApprovalEvent[]           @relation("ApprovalApprover")
  revisions                     ArtifactRevision[]        @relation("RevisionAuthor")
  attachments                   Attachment[]              @relation("AttachmentUploader")
  auditLogs                     AuditLog[]
  businessRequests              BusinessRequest[]         @relation("RequestAuthor")
  comments                      Comment[]                 @relation("CommentAuthor")
  authoredDecisions             DecisionRecord[]          @relation("DecisionAuthor")
  executionEvents               ExecutionEvent[]          @relation("ExecutionTester")
  notifications                 Notification[]
  organizationMemberships       OrganizationMember[]
  members                       ProjectMember[]
  promptVersions                PromptVersion[]           @relation("PromptAuthor")
  authoredReleaseCandidates     ReleaseCandidate[]        @relation("ReleaseAuthor")
  authoredReleaseFollowUps      ReleaseFollowUp[]         @relation("ReleaseFollowUpAuthor")
  authoredRequirements          Requirement[]             @relation("RequirementAuthor")
  teamMemberships               TeamMember[]
  createdCases                  TestCase[]                @relation("CaseAuthor")
  caseHistory                   TestCaseHistory[]         @relation("HistoryAuthor")
  executedResults               TestResult[]              @relation("ResultTester")
  createdRuns                   TestRun[]                 @relation("RunCreator")
  ownedPortfolios               Portfolio[]               @relation("PortfolioOwner")
  ownedInitiatives              PortfolioInitiative[]     @relation("InitiativeOwner")
  ownedDashboards               DashboardDefinition[]     @relation("DashboardOwner")
  dashboardPreferences          DashboardPreference[]
  assignedActionItems           ActionCenterItem[]        @relation("ActionAssignee")
  createdActionItems            ActionCenterItem[]        @relation("ActionCreator")
  resolvedActionItems           ActionCenterItem[]        @relation("ActionResolver")
  assignedRunItems              TestRunItem[]             @relation("ItemAssignee")
  roleBindings                  UserRoleBinding[]
  authoredPages                 WikiPage[]
  assignedWorkItems             WorkItem[]                @relation("ItemAssignee")
  reportedWorkItems             WorkItem[]                @relation("ItemReporter")
  assignedTickets               ServiceTicket[]           @relation("TicketAssignee")
  ticketComments                ServiceTicketComment[]    @relation("TicketCommentAuthor")
  worklogs                      Worklog[]
  authSessions                  AuthSession[]
  securityTokens                SecurityToken[]
  authoredScopeSnapshots        ReleaseScopeSnapshot[]    @relation("ScopeSnapshotAuthor")
  authoredApprovalRounds        ReleaseApprovalRound[]    @relation("ApprovalRoundAuthor")
  releaseApprovalDecisions      ReleaseApprovalDecision[] @relation("StakeholderDecisionAuthor")
  authoredDeployPackages        DeployPackage[]           @relation("DeployPackageAuthor")
  sprintMemberCapacities        SprintMemberCapacity[]
  facilitatedPlanningSessions   SprintPlanningSession[]   @relation("PlanningFacilitator")
  planningEvents                SprintPlanningEvent[]     @relation("PlanningEventActor")
  savedViews                    SavedView[]
  authoredAutomationRules       WorkAutomationRule[]      @relation("AutomationRuleAuthor")
  authoredWorkflowRevisions     WorkflowRevision[]        @relation("WorkflowRevisionAuthor")
  createdMigrationJobs          MigrationJob[]            @relation("MigrationJobCreator")
  createdLegalHolds             LegalHold[]               @relation("LegalHoldCreator")
  releasedLegalHolds            LegalHold[]               @relation("LegalHoldReleaser")
  assignedSecurityIncidents     SecurityIncident[]        @relation("SecurityIncidentAssignee")
  acknowledgedSecurityIncidents SecurityIncident[]        @relation("SecurityIncidentAcknowledger")
  resolvedSecurityIncidents     SecurityIncident[]        @relation("SecurityIncidentResolver")
  recoveryEvidence              RecoveryEvidence[]        @relation("RecoveryEvidenceRecorder")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  read      Boolean   @default(false)
  data      Json?
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([deletedAt])
}

model Project {
  id                             String                    @id @default(uuid())
  name                           String
  key                            String                    @unique
  slug                           String                    @default(cuid())
  description                    String?
  status                         ProjectStatus             @default(ACTIVE)
  qualityTier                    ProjectQualityTier        @default(TIER_2)
  dataClassification             ProjectDataClassification @default(INTERNAL)
  requireExplicitAdminMembership Boolean                   @default(false)
  nextTestCaseNumber             Int                       @default(1)
  nextWorkItemNumber             Int                       @default(1)
  nextTestRunNumber              Int                       @default(1)
  nextMilestoneNumber            Int                       @default(1)
  nextReleaseNumber              Int                       @default(1)
  nextTicketNumber               Int                       @default(1)
  nextWikiPageNumber             Int                       @default(1)
  createdAt                      DateTime                  @default(now())
  updatedAt                      DateTime                  @updatedAt
  organizationId                 String?
  primaryTeamId                  String?
  approvalEvents                 ApprovalEvent[]
  auditLogs                      AuditLog[]
  automationEvents               AutomationEvent[]
  automationScenarios            AutomationScenario[]
  boardColumns                   BoardColumn[]
  businessRequests               BusinessRequest[]
  environments                   Environment[]
  executionEvents                ExecutionEvent[]
  commits                        GitCommit[]
  integrations                   Integration[]             @relation("ProjectIntegrations")
  metricsSnapshots               MetricsSnapshot[]
  milestones                     Milestone[]
  organization                   Organization?             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  primaryTeam                    Team?                     @relation(fields: [primaryTeamId], references: [id], onDelete: SetNull)
  elements                       ProjectElement[]
  members                        ProjectMember[]
  pullRequests                   PullRequest[]
  releaseCandidates              ReleaseCandidate[]
  requirements                   Requirement[]
  sprints                        Sprint[]
  tags                           Tag[]
  testRuns                       TestRun[]
  testSteps                      TestStep[]
  suites                         TestSuite[]
  wikiSpaces                     WikiSpace[]
  workItems                      WorkItem[]
  worklogs                       Worklog[]
  workItemPolicies               WorkItemPolicy[]
  ProjectKnowledge               ProjectKnowledge[]
  planningHolidays               ProjectPlanningHoliday[]
  savedViews                     SavedView[]
  workTypeDefinitions            WorkTypeDefinition[]
  customFieldDefinitions         CustomFieldDefinition[]
  workAutomationRules            WorkAutomationRule[]
  workAutomationExecutions       WorkAutomationExecution[]
  workflowScheme                 WorkflowScheme?
  migrationJobs                  MigrationJob[]
  migrationRecords               MigrationRecord[]
  portfolioMemberships           PortfolioProject[]
  portfolioInitiatives           PortfolioInitiative[]
  dashboardDefinitions           DashboardDefinition[]
  actionCenterItems              ActionCenterItem[]
  serviceTickets                 ServiceTicket[]
  slaPolicies                    SlaPolicy[]
  legalHolds                     LegalHold[]
  routeAliases                   ResourceRouteAlias[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([primaryTeamId])
}

model SavedView {
  id        String   @id @default(uuid())
  name      String
  viewType  String
  scope     String   @default("PERSONAL")
  config    Json
  isDefault Boolean  @default(false)
  userId    String
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, viewType, name])
  @@index([projectId, viewType])
  @@index([userId, projectId])
}

model WorkAutomationRule {
  id             String                    @id @default(uuid())
  projectId      String
  name           String
  description    String?
  trigger        WorkAutomationTrigger
  nqlCondition   String?
  actions        Json
  status         WorkAutomationRuleStatus  @default(DRAFT)
  version        Int                       @default(1)
  executionCount Int                       @default(0)
  lastExecutedAt DateTime?
  createdById    String
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  project        Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User                      @relation("AutomationRuleAuthor", fields: [createdById], references: [id])
  executions     WorkAutomationExecution[]

  @@index([projectId, status, trigger])
}

model WorkAutomationExecution {
  id             String                        @id @default(uuid())
  projectId      String
  ruleId         String
  workItemId     String?
  trigger        WorkAutomationTrigger
  status         WorkAutomationExecutionStatus @default(PENDING)
  input          Json?
  actionResults  Json?
  error          String?
  durationMs     Int?
  idempotencyKey String                        @unique
  retryCount     Int                           @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                      @default(now())
  project        Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rule           WorkAutomationRule            @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([ruleId, createdAt])
  @@index([workItemId])
}

model WorkflowScheme {
  id               String               @id @default(uuid())
  projectId        String               @unique
  name             String
  status           WorkflowSchemeStatus @default(DRAFT)
  publishedVersion Int                  @default(0)
  draftConfig      Json
  publishedConfig  Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions        WorkflowRevision[]
}

model WorkflowRevision {
  id            String         @id @default(uuid())
  schemeId      String
  version       Int
  config        Json
  changeNote    String?
  publishedById String
  createdAt     DateTime       @default(now())
  scheme        WorkflowScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  publishedBy   User           @relation("WorkflowRevisionAuthor", fields: [publishedById], references: [id])

  @@unique([schemeId, version])
  @@index([schemeId, createdAt])
}

model MigrationJob {
  id          String            @id @default(uuid())
  projectId   String
  source      String
  status      String            @default("ANALYZED")
  mode        String            @default("UPSERT")
  mapping     Json
  sourceData  Json
  summary     Json
  errors      Json?
  createdById String
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("MigrationJobCreator", fields: [createdById], references: [id])
  records     MigrationRecord[]

  @@index([projectId, createdAt])
  @@index([status])
}

model MigrationRecord {
  id         String       @id @default(uuid())
  jobId      String
  projectId  String
  source     String
  externalId String
  entityType String
  targetId   String?
  checksum   String
  status     String
  error      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  job        MigrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, source, entityType, externalId])
  @@index([jobId, status])
  @@index([targetId])
}

model WorkTypeDefinition {
  id          String       @id @default(uuid())
  projectId   String
  key         String
  name        String
  description String?
  baseType    WorkItemType
  icon        String?
  color       String?
  orderIndex  Int          @default(0)
  isActive    Boolean      @default(true)
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItems   WorkItem[]

  @@unique([projectId, key])
  @@index([projectId, isActive, orderIndex])
}

model CustomFieldDefinition {
  id           String          @id @default(uuid())
  projectId    String
  key          String
  name         String
  description  String?
  fieldType    CustomFieldType
  itemTypeKeys String[]        @default([])
  required     Boolean         @default(false)
  defaultValue Json?
  options      Json?
  validation   Json?
  orderIndex   Int             @default(0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([projectId, isActive, orderIndex])
}

model ProjectElement {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  locator     String
  type        String
  pageUrl     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Tag {
  id        String        @id @default(uuid())
  name      String
  color     String        @default("#6B7280")
  projectId String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCases TestCaseTag[]

  @@unique([name, projectId])
  @@index([projectId])
  @@index([deletedAt])
}

model TestCaseTag {
  testCaseId String
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@id([testCaseId, tagId])
}

model ProjectMember {
  id                    String      @id @default(uuid())
  projectId             String
  userId                String
  joinedAt              DateTime    @default(now())
  roleId                String?
  weeklyCapacityMinutes Int         @default(2400)
  project               Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role                  AccessRole? @relation(fields: [roleId], references: [id])
  user                  User        @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([roleId])
}

model Milestone {
  id                String             @id @default(uuid())
  key               String             @unique
  sequenceNumber    Int
  name              String
  description       String?
  dueDate           DateTime?
  status            RunStatus          @default(OPEN)
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releaseCandidates ReleaseCandidate[]
  testRuns          TestRun[]
  deletedAt         DateTime?

  @@index([projectId])
  @@index([key])
  @@index([deletedAt])
}

model ExecutionEvent {
  id         String          @id @default(uuid())
  projectId  String
  runId      String
  runItemId  String
  testCaseId String
  testerId   String?
  status     ResultStatus
  durationMs Int?
  source     ExecutionSource
  createdAt  DateTime        @default(now())
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run        TestRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  runItem    TestRunItem     @relation(fields: [runItemId], references: [id], onDelete: Cascade)
  testCase   TestCase        @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  tester     User?           @relation("ExecutionTester", fields: [testerId], references: [id])

  @@index([projectId, createdAt])
  @@index([testerId, createdAt])
}

model ApprovalEvent {
  id         String   @id @default(uuid())
  projectId  String
  testCaseId String
  approverId String?
  createdAt  DateTime @default(now())
  approver   User?    @relation("ApprovalApprover", fields: [approverId], references: [id])
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([approverId, createdAt])
}

model AutomationEvent {
  id          String       @id @default(uuid())
  projectId   String
  runId       String
  runItemId   String
  scenarioId  String?
  status      ResultStatus
  conflict    Boolean      @default(false)
  videoUrl    String?
  errorOutput String?
  createdAt   DateTime     @default(now())
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run         TestRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  runItem     TestRunItem  @relation(fields: [runItemId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model MetricsSnapshot {
  id           String           @id @default(uuid())
  projectId    String
  scope        MetricsScope
  scopeId      String?
  timeframe    MetricsTimeframe
  periodStart  DateTime
  periodEnd    DateTime
  qgi          Float
  passRate     Float
  failRate     Float
  retestRate   Float
  conflictRate Float
  velocity     Float
  defectTrend  Float
  createdAt    DateTime         @default(now())
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, timeframe, periodStart])
}

model TestSuite {
  id          String      @id @default(uuid())
  name        String
  description String?
  projectId   String
  parentId    String?
  deletedAt   DateTime?
  testCases   TestCase[]
  parent      TestSuite?  @relation("SuiteHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    TestSuite[] @relation("SuiteHierarchy")
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([parentId])
}

model TestCase {
  id                  String               @id @default(uuid())
  key                 String               @unique
  sequenceNumber      Int
  title               String
  description         String?
  preconditions       String?
  priority            Priority             @default(MEDIUM)
  status              CaseStatus           @default(DRAFT)
  version             Int                  @default(1)
  impactStatus        ImpactStatus         @default(CLEAN)
  impactReason        String?
  steps               Json?
  automationScript    String?
  suiteId             String
  authorId            String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  workItemId          String?
  requirementId       String?
  approvalEvents      ApprovalEvent[]
  attachments         Attachment[]
  automationScenarios AutomationScenario[]
  executionEvents     ExecutionEvent[]
  author              User                 @relation("CaseAuthor", fields: [authorId], references: [id])
  requirement         Requirement?         @relation(fields: [requirementId], references: [id])
  suite               TestSuite            @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  workItem            WorkItem?            @relation(fields: [workItemId], references: [id])
  history             TestCaseHistory[]
  testCaseSteps       TestCaseStep[]       @relation("CaseToSteps")
  tags                TestCaseTag[]
  runItems            TestRunItem[]

  @@index([suiteId])
  @@index([authorId])
  @@index([workItemId])
  @@index([key])
}

model TestStep {
  id             String                   @id @default(uuid())
  projectId      String
  name           String?
  action         String?
  expectedResult String?
  type           TestPlatform             @default(MANUAL)
  actionType     String?
  locator        String?
  data           String?
  pageObject     String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deletedAt      DateTime?
  scenarioSteps  AutomationScenarioStep[]
  testCaseSteps  TestCaseStep[]
  project        Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, pageObject])
  @@index([deletedAt])
}

model TestCaseStep {
  id         String   @id @default(uuid())
  testCaseId String
  testStepId String
  orderIndex Int
  createdAt  DateTime @default(now())
  testCase   TestCase @relation("CaseToSteps", fields: [testCaseId], references: [id], onDelete: Cascade)
  testStep   TestStep @relation(fields: [testStepId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@index([testStepId])
}

model TestCaseHistory {
  id            String   @id @default(uuid())
  testCaseId    String
  version       Int
  title         String
  steps         Json
  preconditions String?
  changedById   String
  changedAt     DateTime @default(now())
  changedBy     User     @relation("HistoryAuthor", fields: [changedById], references: [id])
  testCase      TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@index([changedById])
}

model Environment {
  id               String            @id @default(uuid())
  projectId        String
  name             String
  description      String?
  type             EnvironmentType   @default(QA)
  orderIndex       Int               @default(0)
  isProduction     Boolean           @default(false)
  requiresApproval Boolean           @default(false)
  deploymentPolicy String?
  rollbackPolicy   String?
  status           EnvironmentStatus @default(ACTIVE)
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testRuns         TestRun[]
  workItemsFound   WorkItem[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([deletedAt])
}

model TestRun {
  id             String    @id @default(uuid())
  key            String    @unique
  sequenceNumber Int
  title          String
  status         RunStatus @default(OPEN)
  environmentId  String?
  totalItems     Int       @default(0)
  passedCount    Int       @default(0)
  failedCount    Int       @default(0)
  blockedCount   Int       @default(0)
  untestedCount  Int       @default(0)
  projectId      String?
  milestoneId    String?
  creatorId      String
  startDate      DateTime?
  dueDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  automationEvents  AutomationEvent[]
  executionEvents   ExecutionEvent[]
  releaseCandidates ReleaseCandidateRun[]
  creator           User                  @relation("RunCreator", fields: [creatorId], references: [id])
  environment       Environment?          @relation(fields: [environmentId], references: [id])
  milestone         Milestone?            @relation(fields: [milestoneId], references: [id])
  project           Project?              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items             TestRunItem[]

  @@index([projectId])
  @@index([key])
  @@index([milestoneId])
  @@index([creatorId])
  @@index([deletedAt])
}

model TestRunItem {
  id                   String            @id @default(uuid())
  testRunId            String
  testCaseId           String
  assigneeId           String?
  caseTitle            String?
  caseSteps            Json?
  casePreconditions    String?
  casePriority         Priority?
  manualStatus         ResultStatus      @default(UNTESTED)
  automationStatus     ResultStatus?
  finalStatus          ResultStatus      @default(UNTESTED)
  manualExecutedAt     DateTime?
  automationExecutedAt DateTime?
  videoUrl             String?
  errorOutput          String?
  automationEvents     AutomationEvent[]
  executionEvents      ExecutionEvent[]
  results              TestResult[]
  assignee             User?             @relation("ItemAssignee", fields: [assigneeId], references: [id])
  testCase             TestCase          @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  testRun              TestRun           @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  @@unique([testRunId, testCaseId])
  @@index([testRunId])
  @@index([testCaseId])
  @@index([assigneeId])
}

model Organization {
  id                   String                      @id @default(uuid())
  name                 String
  slug                 String                      @unique
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  roles                AccessRole[]
  auditLogs            AuditLog[]
  integrations         Integration[]
  members              OrganizationMember[]
  projects             Project[]
  teams                Team[]
  authSessions         AuthSession[]
  oidcProviders        OidcProvider[]
  portfolios           Portfolio[]
  dashboards           DashboardDefinition[]
  dashboardPreferences DashboardPreference[]
  actionItems          ActionCenterItem[]
  scimTokens           ScimToken[]
  serviceTickets       ServiceTicket[]
  slaPolicies          SlaPolicy[]
  securityPolicy       OrganizationSecurityPolicy?
  legalHolds           LegalHold[]
  siemDestinations     SiemDestination[]
  securityIncidents    SecurityIncident[]
  operationalPolicy    OperationalPolicy?
  recoveryEvidence     RecoveryEvidence[]
  sloHourlyBuckets     SloHourlyBucket[]
}

model OperationalPolicy {
  organizationId        String       @id
  availabilityTargetPct Float        @default(99.9)
  latencyP95TargetMs    Int          @default(800)
  errorRateTargetPct    Float        @default(1)
  rpoTargetMinutes      Int          @default(1440)
  rtoTargetMinutes      Int          @default(240)
  backupMaxAgeHours     Int          @default(26)
  maintenanceMode       Boolean      @default(false)
  maintenanceMessage    String?
  maintenanceEndsAt     DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model RecoveryEvidence {
  id                 String                 @id @default(uuid())
  organizationId     String
  type               RecoveryEvidenceType
  status             RecoveryEvidenceStatus
  reference          String
  checksum           String?
  startedAt          DateTime
  completedAt        DateTime
  measuredRpoMinutes Int?
  measuredRtoMinutes Int?
  notes              String?
  recordedById       String
  createdAt          DateTime               @default(now())
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
