model SprintPlanningOutcome {
  id                     String   @id @default(uuid())
  sprintId               String   @unique
  plannedPoints          Int
  plannedMinutes         Int
  completedPoints        Int      @default(0)
  completedMinutes       Int      @default(0)
  spilloverPoints        Int      @default(0)
  unplannedPoints        Int      @default(0)
  meetingDurationMinutes Int      @default(0)
  forecastConfidence     Float?
  calculatedAt           DateTime @default(now())
  sprint                 Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
