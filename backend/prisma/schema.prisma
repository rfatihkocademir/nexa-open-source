  foundInEnv           Environment?              @relation(fields: [foundInEnvId], references: [id])
  parent               WorkItem?                 @relation("ItemHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children             WorkItem[]                @relation("ItemHierarchy")
