  scenarioKey      String?
  goal             String?
  scopeHash        String?
  scopeSnapshot    Json?
  capacitySnapshot Json?
  startedAt        DateTime?
  lockedAt         DateTime?
  completedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  sprint           Sprint                @relation(fields: [sprintId], references: [id], onDelete: Cascade)
