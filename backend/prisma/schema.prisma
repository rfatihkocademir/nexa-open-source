  @@index([commentId])
  @@index([testResultId])
  @@index([testCaseId])
  @@index([wikiPageId])
  @@index([deletedAt])
}

model BusinessRequest {
  id                String                @id @default(uuid())
  title             String
  content           String
  status            BusinessRequestStatus @default(DRAFT)
