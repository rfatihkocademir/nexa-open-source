  authorId          String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  author            User                  @relation("RequestAuthor", fields: [authorId], references: [id])
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releaseCandidates ReleaseCandidate[]
  requirements      Requirement[]
  workItems         WorkItem[]
  deletedAt         DateTime?

  @@index([projectId])
  @@index([deletedAt])
}

model ReleaseCandidate {
  id                 String                 @id @default(uuid())
  key                String                 @unique
  sequenceNumber     Int
  title              String
  summary            String?
  status             ReleaseStatus          @default(DRAFT)
  label              String?
  projectId          String
  createdById        String
  sprintId           String?
  milestoneId        String?
  sourceRequestId    String?
  totalWorkItems     Int                    @default(0)
  completedWorkItems Int                    @default(0)
  openBugs           Int                    @default(0)
  criticalOpenBugs   Int                    @default(0)
  approvedTestCases  Int                    @default(0)
  totalTestCases     Int                    @default(0)
  openRuns           Int                    @default(0)
  failedRunItems     Int                    @default(0)
  blockedRunItems    Int                    @default(0)
  conflictRunItems   Int                    @default(0)
  traceabilityGaps   Int                    @default(0)
  readinessScore     Float?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  decisions          DecisionRecord[]
  createdBy          User                   @relation("ReleaseAuthor", fields: [createdById], references: [id])
  milestone          Milestone?             @relation(fields: [milestoneId], references: [id])
  project            Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceRequest      BusinessRequest?       @relation(fields: [sourceRequestId], references: [id])
  sprint             Sprint?                @relation(fields: [sprintId], references: [id])
  runLinks           ReleaseCandidateRun[]
  followUps          ReleaseFollowUp[]
  workItemLinks      ReleaseWorkItem[]
  scopeSnapshots     ReleaseScopeSnapshot[]
  approvalRounds     ReleaseApprovalRound[]
  deployPackages     DeployPackage[]
  deletedAt          DateTime?

  @@index([projectId, createdAt])
  @@index([key])
  @@index([status, createdAt])
  @@index([deletedAt])
}

model ReleaseScopeSnapshot {
  id                 String                 @id @default(uuid())
  releaseCandidateId String
  version            Int
  scopeHash          String
  manifest           Json
  qualityResult      QualityGateResult
  qualityMetrics     Json
  policySnapshot     Json
  createdById        String
  createdAt          DateTime               @default(now())
  releaseCandidate   ReleaseCandidate       @relation(fields: [releaseCandidateId], references: [id], onDelete: Cascade)
  createdBy          User                   @relation("ScopeSnapshotAuthor", fields: [createdById], references: [id])
  approvalRounds     ReleaseApprovalRound[]
  deployPackages     DeployPackage[]

  @@unique([releaseCandidateId, version])
  @@index([releaseCandidateId, createdAt])
  @@index([scopeHash])
}

model ReleaseApprovalRound {
  id                     String                    @id @default(uuid())
  releaseCandidateId     String
  scopeSnapshotId        String
  roundNumber            Int
  status                 ApprovalRoundStatus       @default(AWAITING_CONSENSUS)
  requiredStakeholderIds String[]
  createdById            String
  createdAt              DateTime                  @default(now())
  completedAt            DateTime?
  releaseCandidate       ReleaseCandidate          @relation(fields: [releaseCandidateId], references: [id], onDelete: Cascade)
  scopeSnapshot          ReleaseScopeSnapshot      @relation(fields: [scopeSnapshotId], references: [id], onDelete: Cascade)
  createdBy              User                      @relation("ApprovalRoundAuthor", fields: [createdById], references: [id])
  decisions              ReleaseApprovalDecision[]
  deployPackages         DeployPackage[]

  @@unique([releaseCandidateId, roundNumber])
  @@index([releaseCandidateId, status])
  @@index([scopeSnapshotId])
}

model ReleaseApprovalDecision {
  id        String               @id @default(uuid())
  roundId   String
  userId    String
  decision  StakeholderDecision
  rationale String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  round     ReleaseApprovalRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user      User                 @relation("StakeholderDecisionAuthor", fields: [userId], references: [id])

  @@unique([roundId, userId])
  @@index([roundId, decision])
  @@index([userId, createdAt])
}

model DeployPackage {
  id                 String               @id @default(uuid())
  releaseCandidateId String
  scopeSnapshotId    String
  approvalRoundId    String
  packageNumber      Int
  status             DeployPackageStatus  @default(READY)
  manifest           Json
  packageHash        String
  createdById        String
  createdAt          DateTime             @default(now())
  releaseCandidate   ReleaseCandidate     @relation(fields: [releaseCandidateId], references: [id], onDelete: Cascade)
  scopeSnapshot      ReleaseScopeSnapshot @relation(fields: [scopeSnapshotId], references: [id], onDelete: Restrict)
  approvalRound      ReleaseApprovalRound @relation(fields: [approvalRoundId], references: [id], onDelete: Restrict)
  createdBy          User                 @relation("DeployPackageAuthor", fields: [createdById], references: [id])

  @@unique([releaseCandidateId, packageNumber])
  @@index([releaseCandidateId, createdAt])
  @@index([packageHash])
}

model ReleaseFollowUp {
  id                 String           @id @default(uuid())
  releaseCandidateId String
  workItemId         String
  sourceActionType   String
  sourceActionFocus  String
  createdById        String
  createdAt          DateTime         @default(now())
  createdBy          User             @relation("ReleaseFollowUpAuthor", fields: [createdById], references: [id])
  releaseCandidate   ReleaseCandidate @relation(fields: [releaseCandidateId], references: [id], onDelete: Cascade)
  workItem           WorkItem         @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  deletedAt          DateTime?

  @@unique([releaseCandidateId, workItemId])
  @@index([releaseCandidateId])
  @@index([workItemId])
  @@index([createdById])
  @@index([deletedAt])
}

model ReleaseCandidateRun {
  releaseCandidateId String
  testRunId          String
  releaseCandidate   ReleaseCandidate @relation(fields: [releaseCandidateId], references: [id], onDelete: Cascade)
  testRun            TestRun          @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  @@id([releaseCandidateId, testRunId])
  @@index([testRunId])
}

model DecisionRecord {
  id                 String           @id @default(uuid())
  releaseCandidateId String
  type               DecisionType
  outcome            DecisionOutcome
  rationale          String?
  confidence         Float?
  authorId           String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  author             User             @relation("DecisionAuthor", fields: [authorId], references: [id])
  releaseCandidate   ReleaseCandidate @relation(fields: [releaseCandidateId], references: [id], onDelete: Cascade)

  @@index([releaseCandidateId, type, createdAt])
  @@index([authorId, createdAt])
}

model ReleaseWorkItem {
  releaseCandidateId String
  workItemId         String
  createdAt          DateTime         @default(now())
  releaseCandidate   ReleaseCandidate @relation(fields: [releaseCandidateId], references: [id], onDelete: Cascade)
