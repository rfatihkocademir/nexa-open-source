  lastSeenAt     DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee       User?            @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy      User?            @relation("ActionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  resolvedBy     User?            @relation("ActionResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status, severity])
  @@index([assigneeId, status])
  @@index([projectId, status])
  @@index([organizationId, actionType, status, lastSeenAt])
}

