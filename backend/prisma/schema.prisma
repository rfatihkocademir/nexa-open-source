  @@index([projectId])
  @@index([deletedAt])
}

model WikiPage {
  id           String         @id @default(uuid())
  key          String?        @unique
  title        String
  content      Json?
  spaceId      String
  parentId     String?
  authorId     String
  version      Int            @default(1)
  status       ArtifactStatus @default(DRAFT)
  impactStatus ImpactStatus   @default(CLEAN)
  impactReason String?
