# Target backend
API_BASE_URL=http://127.0.0.1:1996

# Use an existing seeded account, or provide API_AUTH_TOKEN instead.
API_EMAIL=
API_PASSWORD=
API_ORGANIZATION_SLUG=
API_AUTH_TOKEN=

# Optional: use an existing project instead of creating test data.
API_PROJECT_ID=

# The route catalog is generated from this source tree.
BACKEND_SOURCE_DIR=../backend/src

# Endpoint smoke policy. Keep false to fail on backend 5xx responses.
ALLOW_DEPENDENCY_503=false
